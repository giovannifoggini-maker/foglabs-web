# For local use only. Never commit a real .env file.
NODE_ENV=development
PORT=3100
# Set this in your private local .env (never commit .env). In Render, set the same variable in the service Environment settings.
VIP_EMAIL_CODE=
# Optional Discord OAuth; keep empty if not configured.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:3100/api/discord/oauth/callback
# Leave DATABASE_URL unset for local JSON-file mode. Configure it in Render for deployment.
